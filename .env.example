# Runtime
NODE_ENV=development
APP_ENV=local
TZ=Asia/Kolkata

# Database (local Docker Postgres; production uses Aurora via RDS Proxy)
DATABASE_URL=postgres://erp:erp@localhost:5435/erp

# Auth
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare origin (local dev) / CloudFront origin secret (production)
ORIGIN_SECRET=local-dev-secret

# Storage (local filesystem; production uses S3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./.local/storage
# AWS_S3_BUCKET=erp-prod-documents
# AWS_REGION=ap-south-1

# Email
EMAIL_DRIVER=console
RESEND_API_KEY=

# SMS
SMS_DRIVER=console
MSG91_AUTH_KEY=

# WhatsApp
WHATSAPP_DRIVER=console

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Push
FCM_SERVICE_ACCOUNT_JSON=

# Observability
SENTRY_DSN=
LOG_LEVEL=debug

# Feature flags
FEATURE_FLAGS=