# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_erp

# Authentication
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-key-here

# Cloudflare (Origin Secret)
CLOUDFLARE_ORIGIN_SECRET=your-origin-secret-here

# Default School Slug (development)
DEFAULT_SCHOOL_SLUG=greenwood

# Node Environment
NODE_ENV=development

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Cloud Storage (for file uploads)
GCS_BUCKET_NAME=school-erp-files
GCS_PROJECT_ID=your-gcp-project-id

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SMS (optional)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-twilio-sid
SMS_AUTH_TOKEN=your-twilio-token