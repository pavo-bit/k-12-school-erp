# Runtime
NODE_ENV=development
APP_ENV=local
TZ=Asia/Kolkata

# Database (local Docker Postgres; production uses Aurora via RDS Proxy)
# DATABASE_URL is the local superuser/owner (RLS-bypassed) — the app runs this way in
# development only. Production must use erp_app (NO BYPASSRLS) with request-scoped
# tenant context (see withTenantContext in packages/db/src/tenant.ts).
DATABASE_URL=postgres://erp:erp@localhost:5435/erp

# Runtime roles (created by packages/db/scripts/bootstrap.ts or infra/db/bootstrap.sql)
# erp_app   = app role, RLS-enforced (production DATABASE_URL)
# erp_auth  = auth role, BYPASSRLS (production AUTH_DATABASE_URL)
ERP_APP_PASSWORD=erp_app
ERP_AUTH_PASSWORD=erp_auth
ERP_MIGRATIONS_PASSWORD=erp_migrations

# Production posture (set these to run the app for real):
#   DATABASE_URL=postgres://erp_app:erp_app@<host>:5432/erp
#   AUTH_DATABASE_URL=postgres://erp_auth:erp_auth@<host>:5432/erp
# Local default stays the owner connection so RLS is not in the dev path.
# AUTH_DATABASE_URL=

# Test suite (packages/testing) — runs as the production role to prove RLS isolation
TEST_DATABASE_URL=postgres://erp:erp@localhost:5435/erp
TEST_APP_DATABASE_URL=postgres://erp_app:erp_app@localhost:5435/erp
# TEST_SCHOOL_ID defaults to the seeded Greenwood school; tests auto-discover it by slug.

# Auth
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare origin (local dev) / CloudFront origin secret (production)
ORIGIN_SECRET=local-dev-secret

# Storage (local filesystem; production uses S3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./.local/storage
# AWS_S3_BUCKET=erp-prod-documents
# AWS_REGION=ap-south-1

# Email
EMAIL_DRIVER=console
RESEND_API_KEY=

# SMS
SMS_DRIVER=console
MSG91_AUTH_KEY=

# WhatsApp
WHATSAPP_DRIVER=console

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Push
FCM_SERVICE_ACCOUNT_JSON=

# Observability
SENTRY_DSN=
LOG_LEVEL=debug

# Feature flags
FEATURE_FLAGS=